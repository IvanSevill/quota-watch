{
  "name": "quota-watch",
  "version": "1.1.0",
  "description": "Shows remaining Claude Code and Codex quota for people, scripts, and agents",
  "bin": { "quota-watch": "./usage.mjs", "usage": "./usage.mjs" },
  "type": "module",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "license": "MIT",
  "exports": {
    ".": "./quota/index.mjs",
    "./schema": "./quota/schema.mjs",
    "./cache": "./quota/cache.mjs",
    "./guard": "./quota/guard.mjs",
    "./remaining": "./quota/remaining.mjs",
    "./claude": "./quota/claude.mjs",
    "./codex-app-server": "./quota/codex-app-server.mjs",
    "./codex-rollout": "./quota/codex-rollout.mjs",
    "./headers": "./quota/headers.mjs",
